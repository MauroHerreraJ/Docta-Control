{
  "expo": {
    "name": "Docta",
    "slug": "5_DoctaControl",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/doctaoscuro.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pedrodarrigo.doctacontrol",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Docta usa el reconocimiento de voz para dictar novedades.",
        "NSMicrophoneUsageDescription": "Docta usa el micrófono para grabar y dictar novedades.",
        "UIBackgroundModes": ["audio", "location", "fetch", "remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#384E59",
        "foregroundImage": "./assets/doctaoscuro.png",
        "backgroundImage": "./assets/doctaoscuro.png"
      },
      "package": "com.pedrodarrigo.x5_DoctaControl",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.NFC",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Docta usa la ubicación para seguir en servicio con la pantalla apagada.",
          "locationWhenInUsePermission": "Docta usa la ubicación mientras estás en servicio.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "aviso-alarma-v2"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Docta usa la cámara para leer los QR de la ronda.",
          "microphonePermission": "Docta usa el micrófono para grabar y dictar novedades.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "react-native-nfc-manager",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Docta usa la biometría para reconocer tu usuario. La clave se pide siempre."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Docta usa el micrófono para grabar la novedad.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Docta usa el micrófono para dictar novedades.",
          "speechRecognitionPermission": "Docta usa el reconocimiento de voz para dictar novedades."
        }
      ],
      "expo-asset",
      "./plugins/withDoctaOverlay.js"
    ],
    "web": {
      "favicon": "./assets/doctaoscuro.png"
    },
    "extra": {
      "eas": {
        "projectId": "ac7feaf8-56a5-41f9-9356-87f828227e37"
      }
    },
    "owner": "pedrodarrigo"
  }
}
