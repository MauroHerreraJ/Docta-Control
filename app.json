{
  "expo": {
    "name": "Docta",
    "slug": "5_DoctaControl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.pedrodarrigo.x5_DoctaControl",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Docta usa la ubicación para seguir en servicio con la pantalla apagada.",
          "locationWhenInUsePermission": "Docta usa la ubicación mientras estás en servicio.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "aviso-panel"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Docta usa la cámara para leer los QR de la ronda.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "react-native-nfc-manager",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Docta usa la biometría para reconocer tu usuario. La clave se pide siempre."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Docta usa el micrófono para grabar la novedad.",
          "recordAudioAndroid": true
        }
      ],
      "expo-speech-recognition",
      "expo-asset"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
